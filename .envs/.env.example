# Copy to .envs/.env.local (local.yml) or .envs/.env.production (production.yml) and fill in.
# Both files are git-ignored. Never commit real values.

# Database (also read by the postgres container to create the database and user)
POSTGRES_DB=tenantsphere
POSTGRES_USER=tenantsphere
POSTGRES_PASSWORD=change-me

# JWT signing key: a long random string, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
SIGNING_KEY=change-me

# Public site URL used in emails, without a trailing slash.
DOMAIN=https://example.com
SITE_NAME=Tenant Sphere

# Auth cookies are Secure by default. Keep true behind HTTPS. Set false only for plain-HTTP local
# development (Safari drops Secure cookies even on http://localhost; local.yml already sets false).
COOKIE_SECURE=true

# Optional demo: one temporary account per visitor, expiring after 24 hours.
GUEST_LOGIN_ENABLED=false

# Mail. The defaults (localhost:1025, no auth) only suit Mailpit; local.yml points them at its
# mailpit container. Production needs a real relay, otherwise activation and password-reset
# emails are logged as failures and never arrive. Example: Gmail with an app password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_AUTH=true
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_CLIENT_NAME=example.com
DEFAULT_FROM_EMAIL=you@example.com

# Google sign-in (optional). Register https://<your domain>/google as the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URIS=https://example.com/google

APP_LOG_LEVEL=INFO
